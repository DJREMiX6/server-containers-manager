{
  "name": "server-container-manager-frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/server-container-manager-frontend/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/server-container-manager-frontend",
        "browser": "apps/server-container-manager-frontend/src/main.ts",
        "tsConfig": "apps/server-container-manager-frontend/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/server-container-manager-frontend/public"
          }
        ],
        "styles": ["apps/server-container-manager-frontend/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "./environments/src/lib/environment.dev.ts",
              "with": "./environments/src/lib/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production",
      "syncGenerators": ["@juristr/nx-tailwind-sync:source-directives"]
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "server-container-manager-frontend:build:production"
        },
        "development": {
          "buildTarget": "server-container-manager-frontend:build:development"
        }
      },
      "defaultConfiguration": "development",
      "syncGenerators": ["@juristr/nx-tailwind-sync:source-directives"]
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {}
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "server-container-manager-frontend:build",
        "port": 4200,
        "staticFilePath": "dist/apps/server-container-manager-frontend/browser",
        "spa": true
      }
    }
  }
}
